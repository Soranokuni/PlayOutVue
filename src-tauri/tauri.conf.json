{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PlayOut",
  "version": "2.0.1",
  "identifier": "com.playout.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "powershell -ExecutionPolicy Bypass -File scripts/download-ffmpeg.ps1 && powershell -ExecutionPolicy Bypass -File scripts/download-vcredist.ps1 && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PlayOut — CasparCG Playout Controller",
        "width": 1400,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../Requirements/ffmpeg/bin/*": "Requirements/ffmpeg/bin/",
      "../Requirements/vcredist/*": "Requirements/vcredist/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
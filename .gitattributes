# The CG advisory template is assembled from templates-src/advisory/ by
# scripts/build-advisory.mjs, and the two committed copies must be byte-identical
# (src/lib/__tests__/templatesParity.test.ts). The build concatenates the parts
# verbatim, so a checkout that rewrote their line endings would produce a mixed
# file. Pin both the sources and the output to CRLF on every platform.
templates-src/advisory/**  text eol=crlf
templates-src/advisory/*.md text eol=lf
public/templates/playout/*.html      text eol=crlf
src/assets/templates/playout/*.html  text eol=crlf

# Build scripts stay LF: Vite's transform rejects a CRLF .mjs outright, so a
# checkout that converted them broke the test that imports the build script
# with a bare "SyntaxError: Invalid or unexpected token".
scripts/*.mjs text eol=lf

# Vendored faces are binary.
*.woff2 binary
